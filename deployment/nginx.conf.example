limit_req_zone $binary_remote_addr zone=chainlit_login:10m rate=5r/m;

upstream chainlit_memory {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name internal-ai.example.local;

    ssl_certificate /etc/pki/tls/certs/internal-ai.crt;
    ssl_certificate_key /etc/pki/tls/private/internal-ai.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://chainlit_memory;
    }

    location / {
        proxy_pass http://chainlit_memory;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 360s;

        # In header auth mode these values must be overwritten by, not copied
        # from, the client request. Populate from the authenticated proxy.
        proxy_set_header X-Remote-User-ID "";
        proxy_set_header X-Remote-User "";
        proxy_set_header X-Remote-Display-Name "";
    }

    location ~ ^/login {
        limit_req zone=chainlit_login burst=3 nodelay;
        proxy_pass http://chainlit_memory;
    }
}
